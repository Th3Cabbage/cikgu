     }
    },
    {
     "index": 2,
     "title": "Two more steps",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "y_2 = 30 + 60 = 90,\\qquad y_3 = 90 + 180 = 270",
     "explanation": "Each step multiplies by $1 + 2h = 3$.",
     "initialFrame": "animations/euler-steps/state-01.jpg",
     "finalFrame": "animations/euler-steps/state-02.jpg",
     "transition": {
      "src": "animations/euler-steps/step-02.mp4",

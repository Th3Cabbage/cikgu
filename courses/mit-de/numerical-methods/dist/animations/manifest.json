  {
   "id": "bs23-control",
   "scene": "BS23ControlSequence",
   "section": 4,
   "title": "An adaptive step: estimate, test, adjust",
   "summary": "BS23 computes three slopes, a third-order step, a fourth slope and an error estimate; the step is accepted or rejected and $h$ is rescaled.",
   "initial": {
    "title": "BS23 stages",
    "tex": "s_1,\\ s_2\\ (t + \\tfrac h2),\\ s_3\\ (t + \\tfrac34h)",
    "explanation": "Three slopes inside the step.",
    "frame": "animations/bs23-control/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Step and new slope",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "y_{n+1} = y_n + \\tfrac h9(2s_1 + 3s_2 + 4s_3),\\quad s_4 = f(t_{n+1}, y_{n+1})",
     "explanation": "Third-order result; $s_4$ will be reused (FSAL).",
     "initialFrame": "animations/bs23-control/state-00.jpg",
     "finalFrame": "animations/bs23-control/state-01.jpg",
     "transition": {
      "src": "animations/bs23-control/step-01.mp4",
      "duration": 2.1333,
      "frames": 64,
      "masterFrames": [
       8,
       72
      ],
      "bytes": 46433,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Error estimate",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "e = \\tfrac{h}{72}(-5s_1 + 6s_2 + 8s_3 - 9s_4)",
     "explanation": "The difference from an embedded second-order formula.",
     "initialFrame": "animations/bs23-control/state-01.jpg",
     "finalFrame": "animations/bs23-control/state-02.jpg",
     "transition": {
      "src": "animations/bs23-control/step-02.mp4",
      "duration": 1.5,
      "frames": 45,
      "masterFrames": [
       71,
       116
      ],
      "bytes": 57785,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Test and adjust",
     "relation": "classify",
     "relationLabel": "Classification",
     "tex": "\\frac{|e|}{|y|} \\le \\text{tol}:\\ \\text{accept};\\quad h \\leftarrow 0.8\\,h\\left(\\frac{\\text{tol}}{\\text{err}}\\right)^{1/3}",
     "explanation": "Too large: reject and retry with a smaller $h$; small: accept and grow $h$ (at most $5$ times).",
     "initialFrame": "animations/bs23-control/state-02.jpg",
     "finalFrame": "animations/bs23-control/state-03.jpg",
     "transition": {
      "src": "animations/bs23-control/step-03.mp4",

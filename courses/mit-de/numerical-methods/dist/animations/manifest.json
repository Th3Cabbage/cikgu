  {
   "id": "rk4-stages",
   "scene": "RK4StagesSequence",
   "section": 2,
   "title": "Midpoint and RK4: better slopes inside the step",
   "summary": "From $y_0 = 10$ with $h = 1$: midpoint gives $50$, RK4's four slopes $20, 40, 60, 140$ give $70$ (exact $73.9$).",
   "initial": {
    "title": "One step of $y' = 2y$",
    "tex": "y_0 = 10,\\quad h = 1,\\quad y(1) = 10e^2 \\approx 73.9",
    "explanation": "Compare three ways of choosing the slope.",
    "frame": "animations/rk4-stages/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Midpoint",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "s_2 = f(\\tfrac12,\\ 10 + \\tfrac12\\cdot20) = 40,\\quad y_1 = 10 + 40 = 50",
     "explanation": "An Euler half step finds the midpoint; its slope carries the full step.",
     "initialFrame": "animations/rk4-stages/state-00.jpg",
     "finalFrame": "animations/rk4-stages/state-01.jpg",
     "transition": {
      "src": "animations/rk4-stages/step-01.mp4",
      "duration": 2.6333,
      "frames": 79,
      "masterFrames": [
       8,
       87
      ],
      "bytes": 47354,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Four RK4 slopes",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "s_1 = 20,\\ s_2 = 40,\\ s_3 = 60,\\ s_4 = 140",
     "explanation": "Start, midpoint twice (the second using $s_2$), end (using $s_3$).",
     "initialFrame": "animations/rk4-stages/state-01.jpg",
     "finalFrame": "animations/rk4-stages/state-02.jpg",
     "transition": {
      "src": "animations/rk4-stages/step-02.mp4",
      "duration": 2.3,
      "frames": 69,
      "masterFrames": [
       86,
       155
      ],
      "bytes": 66163,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Weighted average",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "y_1 = 10 + \\tfrac16(20 + 80 + 120 + 140) = 70",
     "explanation": "Weights $1, 2, 2, 1$; the closest of the three to $73.9$.",
     "initialFrame": "animations/rk4-stages/state-02.jpg",
     "finalFrame": "animations/rk4-stages/state-03.jpg",

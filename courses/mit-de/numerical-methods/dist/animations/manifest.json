   "id": "euler-steps",
   "scene": "EulerStepsSequence",
   "section": 1,
   "title": "Euler on $y' = 2y$, $y(0) = 10$, $h = 1$",
   "summary": "Each step follows the tangent at its left end: $30$, $90$, $270$, falling ever further below $10e^{2t}$.",
   "initial": {
    "title": "Exact solution",
    "tex": "y = 10e^{2t}",
    "explanation": "The values grow fast; Euler will lag behind.",
    "frame": "animations/euler-steps/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "First step",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "s_1 = 2\\cdot10 = 20,\\quad y_1 = 10 + 1\\cdot20 = 30",
     "explanation": "Follow the tangent line for one unit of time.",
     "initialFrame": "animations/euler-steps/state-00.jpg",
     "finalFrame": "animations/euler-steps/state-01.jpg",
     "transition": {
      "src": "animations/euler-steps/step-01.mp4",

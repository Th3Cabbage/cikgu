  {
   "id": "stiff-euler",
   "scene": "StiffEulerSequence",
   "section": 5,
   "title": "Stiffness: explicit Euler explodes, implicit Euler decays",
   "summary": "For $y' = -100y$ with $h = 0.05$: Euler multiplies by $-4$ each step; backward Euler by $\\tfrac16$.",
   "initial": {
    "title": "A fast decay",
    "tex": "y' = -100y,\\quad y(0) = 1,\\quad h = 0.05",
    "explanation": "The true solution $e^{-100t}$ is essentially zero after $t = 0.05$.",
    "frame": "animations/stiff-euler/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Explicit Euler",
     "relation": "caution",
     "relationLabel": "Caveat",
     "tex": "y_{n+1} = (1 - 100h)y_n = -4y_n:\\ 1, -4, 16, -64",
     "explanation": "Alternating and growing: unstable because $|1 + h\\lambda| > 1$.",
     "initialFrame": "animations/stiff-euler/state-00.jpg",
     "finalFrame": "animations/stiff-euler/state-01.jpg",
     "transition": {
      "src": "animations/stiff-euler/step-01.mp4",
      "duration": 1.9,
      "frames": 57,
      "masterFrames": [
       8,
       65
      ],
      "bytes": 39711,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Backward Euler",
     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "y_{n+1} = y_n - 100h\\,y_{n+1}\\ \\Rightarrow\\ y_{n+1} = \\tfrac{1}{6}y_n",
     "explanation": "The slope at the end of the step; stable for every $h$.",
     "initialFrame": "animations/stiff-euler/state-01.jpg",
     "finalFrame": "animations/stiff-euler/state-02.jpg",
     "transition": {
      "src": "animations/stiff-euler/step-02.mp4",
      "duration": 1.6667,
      "frames": 50,
      "masterFrames": [
       64,
       114
      ],
      "bytes": 50844,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "The limit",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "\\text{Euler stable} \\Leftrightarrow h \\le \\frac{2}{|\\lambda|} = 0.02",
     "explanation": "Stability, not accuracy, limits explicit methods on stiff problems.",
     "initialFrame": "animations/stiff-euler/state-02.jpg",
     "finalFrame": "animations/stiff-euler/state-03.jpg",

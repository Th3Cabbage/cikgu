  {
   "id": "ata-nonnegative",
   "scene": "AtANonnegativeSequence",
   "section": 1,
   "title": "Why $A^TA$ has no negative eigenvalues",
   "summary": "Multiply $A^TAx = \\lambda x$ by $x^T$ and recognise a squared length.",
   "initial": {
    "title": "An eigenvector of $A^TA$",
    "tex": "A^TA\\,x = \\lambda x",
    "explanation": "$A$ can be any rectangular matrix.",
    "frame": "animations/ata-nonnegative/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Multiply by $x^T$",
     "relation": "substitute",
     "relationLabel": "Substitution",
     "tex": "x^TA^TAx = \\lambda\\,x^Tx",
     "explanation": "Both sides become numbers.",
     "initialFrame": "animations/ata-nonnegative/state-00.jpg",
     "finalFrame": "animations/ata-nonnegative/state-01.jpg",
     "transition": {
      "src": "animations/ata-nonnegative/step-01.mp4",
      "duration": 1.5667,
      "frames": 47,
      "masterFrames": [
       8,
       55
      ],
      "bytes": 68641,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "A squared length",
     "relation": "identity",
     "relationLabel": "Identity (=)",
     "tex": "x^TA^TAx = (Ax)^T(Ax) = \\|Ax\\|^2",
     "explanation": "Group the factors in pairs.",
     "initialFrame": "animations/ata-nonnegative/state-01.jpg",
     "finalFrame": "animations/ata-nonnegative/state-02.jpg",
     "transition": {
      "src": "animations/ata-nonnegative/step-02.mp4",
      "duration": 2.8,
      "frames": 84,
      "masterFrames": [
       54,
       138
      ],
      "bytes": 116213,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "The sign of $\\lambda$",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "\\lambda = \\frac{\\|Ax\\|^2}{\\|x\\|^2} \\ge 0",
     "explanation": "Strictly positive when $Ax \\neq 0$, that is, when $A$ has independent columns.",
     "initialFrame": "animations/ata-nonnegative/state-02.jpg",
     "finalFrame": "animations/ata-nonnegative/state-03.jpg",
     "transition": {
      "src": "animations/ata-nonnegative/step-03.mp4",
      "duration": 2.0667,
      "frames": 62,
      "masterFrames": [
       137,
       199
      ],
      "bytes": 105012,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 6.433,
   "masterFrames": 199,
   "renderSeconds": 7.3
  },
  {
   "id": "five-tests",
   "scene": "FiveTestsSequence",
   "section": 2,
   "title": "Pivots, determinants and energy for $\\begin{bmatrix}4&6\\\\6&10\\end{bmatrix}$",
   "summary": "Elimination gives pivots $4, 1$; completing the square shows the same pivots in the energy.",
   "initial": {
    "title": "The matrix",
    "tex": "S = \\begin{bmatrix}4 & 6\\\\ 6 & 10\\end{bmatrix}",
    "explanation": "Symmetric. Is it positive definite?",
    "frame": "animations/five-tests/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Elimination",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "\\text{row}_2 - \\tfrac32\\,\\text{row}_1:\\quad \\begin{bmatrix}4 & 6\\\\ 0 & 1\\end{bmatrix},\\ \\text{pivots } 4,\\ 1",
     "explanation": "Both pivots positive.",
     "initialFrame": "animations/five-tests/state-00.jpg",
     "finalFrame": "animations/five-tests/state-01.jpg",
     "transition": {
      "src": "animations/five-tests/step-01.mp4",
      "duration": 2.4667,
      "frames": 74,
      "masterFrames": [
       8,
       82
      ],
      "bytes": 51877,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Upper-left determinants",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "\\det[4] = 4,\\qquad \\det S = 40 - 36 = 4",
     "explanation": "The second determinant is the product of the pivots.",
     "initialFrame": "animations/five-tests/state-01.jpg",
     "finalFrame": "animations/five-tests/state-02.jpg",
     "transition": {
      "src": "animations/five-tests/step-02.mp4",
      "duration": 2.0333,
      "frames": 61,
      "masterFrames": [
       81,
       142
      ],
      "bytes": 48493,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Energy",
     "relation": "identity",
     "relationLabel": "Identity (=)",
     "tex": "x^TSx = 4x_1^2 + 12x_1x_2 + 10x_2^2 = 4\\left(x_1 + \\tfrac32x_2\\right)^2 + 1\\cdot x_2^2",
     "explanation": "Completing the square puts the pivots in front of the squares: positive for $x \\neq 0$.",
     "initialFrame": "animations/five-tests/state-02.jpg",
     "finalFrame": "animations/five-tests/state-03.jpg",
     "transition": {
      "src": "animations/five-tests/step-03.mp4",
      "duration": 3.0333,
      "frames": 91,
      "masterFrames": [
       141,
       232
      ],
      "bytes": 136592,
      "codec": "h264"
     }
    }
   ],

     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "Av = (3, 4, 4):\\quad v = (2, 1, 0) + c(-1, -1, 1)",
     "explanation": "Two of column 1 plus one of column 2 reach $b$; add any null vector.",
     "initialFrame": "animations/column-combination/state-02.jpg",
     "finalFrame": "animations/column-combination/state-03.jpg",

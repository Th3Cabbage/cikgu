   "id": "column-combination",
   "scene": "ColumnCombinationSequence",
   "section": 1,
   "title": "$Av$ is a combination of columns",
   "summary": "Split $Av$ into column pieces, spot column 3 = column 1 + column 2, and read off the null space and a particular solution.",
   "initial": {
    "title": "The lecture's matrix",
    "tex": "A = \\begin{bmatrix}1 & 1 & 2\\\\ 1 & 2 & 3\\\\ 1 & 2 & 3\\end{bmatrix}",
    "explanation": "Three columns in $\\mathbb{R}^3$.",
    "frame": "animations/column-combination/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Columns times weights",
     "relation": "identity",
     "relationLabel": "Identity (=)",
     "tex": "Av = v_1\\begin{bmatrix}1\\\\1\\\\1\\end{bmatrix} + v_2\\begin{bmatrix}1\\\\2\\\\2\\end{bmatrix} + v_3\\begin{bmatrix}2\\\\3\\\\3\\end{bmatrix}",
     "explanation": "Each $v_j$ multiplies column $j$.",
     "initialFrame": "animations/column-combination/state-00.jpg",
     "finalFrame": "animations/column-combination/state-01.jpg",
     "transition": {
      "src": "animations/column-combination/step-01.mp4",
      "duration": 2.8333,

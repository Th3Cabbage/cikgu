       8,
       93
      ],
      "bytes": 63308,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "A dependent column",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "\\text{col}_3 = \\text{col}_1 + \\text{col}_2 \\;\\Rightarrow\\; A(-1, -1, 1) = 0",
     "explanation": "So $C(A)$ is only a plane and $N(A)$ is a line.",
     "initialFrame": "animations/column-combination/state-01.jpg",
     "finalFrame": "animations/column-combination/state-02.jpg",
     "transition": {
      "src": "animations/column-combination/step-02.mp4",

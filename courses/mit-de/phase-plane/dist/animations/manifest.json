  {
   "id": "trace-determinant",
   "scene": "TraceDeterminantSequence",
   "section": 4,
   "title": "Stability from the trace and the determinant",
   "summary": "$\\lambda^2 - T\\lambda + D = 0$ places every $2\\times2$ matrix in the $(T, D)$ plane.",
   "initial": {
    "title": "A 2 by 2 system",
    "tex": "\\mathbf{z}' = A\\mathbf{z},\\qquad A = \\begin{bmatrix}a & b\\\\ c & d\\end{bmatrix}",
    "explanation": "Try $\\mathbf{z} = e^{\\lambda t}\\mathbf{x}$.",
    "frame": "animations/trace-determinant/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Characteristic equation",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "\\det(A - \\lambda I) = \\lambda^2 - (a + d)\\lambda + (ad - bc) = 0",
     "explanation": "Sum of eigenvalues $T = a + d$; product $D = ad - bc$.",
     "initialFrame": "animations/trace-determinant/state-00.jpg",
     "finalFrame": "animations/trace-determinant/state-01.jpg",
     "transition": {
      "src": "animations/trace-determinant/step-01.mp4",

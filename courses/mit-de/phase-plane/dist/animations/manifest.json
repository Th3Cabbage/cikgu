     "relation": "diagram",
     "relationLabel": "Picture",
     "tex": "D < 0:\\ \\text{saddle};\\quad T^2 < 4D:\\ \\text{spiral};\\quad T^2 > 4D > 0:\\ \\text{node}",
     "explanation": "The parabola $T^2 = 4D$ separates real from complex eigenvalues.",
     "initialFrame": "animations/trace-determinant/state-01.jpg",
     "finalFrame": "animations/trace-determinant/state-02.jpg",

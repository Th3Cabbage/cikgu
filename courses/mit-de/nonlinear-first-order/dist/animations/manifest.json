  {
   "id": "stability-line",
   "scene": "StabilityLineSequence",
   "section": 2,
   "title": "The stability line for $y' = y - y^3$",
   "summary": "The sign of $f$ on each interval sets an arrow; arrows into a point mean stable.",
   "initial": {
    "title": "Three steady states",
    "tex": "f(y) = y - y^3 = y(1 - y)(1 + y)",
    "explanation": "Roots at $-1$, $0$ and $1$.",
    "frame": "animations/stability-line/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Sign of $f$ on each interval",
     "relation": "classify",
     "relationLabel": "Classification",
     "tex": "f > 0 \\text{ on } (-\\infty,-1) \\cup (0,1),\\qquad f < 0 \\text{ on } (-1,0) \\cup (1,\\infty)",
     "explanation": "Positive $f$ moves $y$ up (right on the line), negative $f$ moves it down.",
     "initialFrame": "animations/stability-line/state-00.jpg",
     "finalFrame": "animations/stability-line/state-01.jpg",
     "transition": {
      "src": "animations/stability-line/step-01.mp4",
      "duration": 1.9667,
      "frames": 59,
      "masterFrames": [
       8,
       67
      ],
      "bytes": 21498,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Arrows on the line",
     "relation": "diagram",
     "relationLabel": "Picture",
     "tex": "\\longrightarrow\\ -1\\ \\longleftarrow\\ \\ 0\\ \\longrightarrow\\ 1\\ \\longleftarrow",
     "explanation": "The arrows copy the signs onto one line of $y$ values.",
     "initialFrame": "animations/stability-line/state-01.jpg",
     "finalFrame": "animations/stability-line/state-02.jpg",
     "transition": {
      "src": "animations/stability-line/step-02.mp4",
      "duration": 3.2333,
      "frames": 97,
      "masterFrames": [
       66,
       163
      ],
      "bytes": 49277,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Read off stability",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "-1,\\ 1 \\text{ stable } (f' = -2),\\qquad 0 \\text{ unstable } (f' = 1)",
     "explanation": "Arrows point into $\\pm1$ and away from $0$, which agrees with the slope test.",
     "initialFrame": "animations/stability-line/state-02.jpg",

  {
   "id": "separate",
   "scene": "SeparateSequence",
   "section": 3,
   "title": "Separating $y' = t/y$",
   "summary": "Move $y$ to one side and $t$ to the other, integrate, and solve for $y$; from $y(0) = 0$ two solutions appear.",
   "initial": {
    "title": "A separable equation",
    "tex": "\\frac{dy}{dt} = \\frac{t}{y}",
    "explanation": "A function of $t$ divided by a function of $y$.",
    "frame": "animations/separate/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Separate",
     "relation": "identity",
     "relationLabel": "Identity (=)",
     "tex": "y\\,dy = t\\,dt",
     "explanation": "Multiply both sides by $y\\,dt$.",
     "initialFrame": "animations/separate/state-00.jpg",
     "finalFrame": "animations/separate/state-01.jpg",
     "transition": {
      "src": "animations/separate/step-01.mp4",
      "duration": 2.1333,
      "frames": 64,
      "masterFrames": [
       8,
       72
      ],
      "bytes": 58898,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Integrate from the start",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "\\tfrac12 y^2 - \\tfrac12 y(0)^2 = \\tfrac12 t^2",
     "explanation": "Integrate $y$ from $y(0)$ to $y(t)$ and $t$ from $0$ to $t$.",
     "initialFrame": "animations/separate/state-01.jpg",
     "finalFrame": "animations/separate/state-02.jpg",
     "transition": {
      "src": "animations/separate/step-02.mp4",
      "duration": 1.9667,
      "frames": 59,
      "masterFrames": [
       71,
       130
      ],
      "bytes": 81312,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Solve for $y$",
     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "y(t) = \\sqrt{y(0)^2 + t^2}",
     "explanation": "Positive root for a positive start: hyperbola branches.",
     "initialFrame": "animations/separate/state-02.jpg",
     "finalFrame": "animations/separate/state-03.jpg",
     "transition": {
      "src": "animations/separate/step-03.mp4",
      "duration": 3.1,
      "frames": 93,
      "masterFrames": [
       129,
       222
      ],
      "bytes": 100924,
      "codec": "h264"
     }
    },
    {
     "index": 4,
     "title": "A start at zero",
     "relation": "caution",
     "relationLabel": "Caveat",
     "tex": "y(0) = 0:\\quad y = t \\ \\text{ and } \\ y = -t \\quad (t \\neq 0)",
     "explanation": "At the start $t/y$ is $0/0$. Both lines satisfy the equation for $t \\neq 0$ and run into the origin, but neither is a solution at $t = 0$ itself: the guarantee of one solution is lost.",
     "initialFrame": "animations/separate/state-03.jpg",
     "finalFrame": "animations/separate/state-04.jpg",

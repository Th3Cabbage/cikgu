  {
   "id": "step-delta",
   "scene": "StepDeltaSequence",
   "section": 6,
   "title": "Step, delta and the impulse response",
   "summary": "The step jumps from 0 to 1; its derivative is the delta, one unit in one instant; the delta input produces the impulse response.",
   "initial": {
    "title": "The unit step",
    "tex": "H(t - T) = \\begin{cases}0 & t < T\\\\ 1 & t \\ge T\\end{cases}",
    "explanation": "A switch that turns on at $t = T$ and stays on.",
    "frame": "animations/step-delta/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Its derivative: the delta",
     "relation": "define",

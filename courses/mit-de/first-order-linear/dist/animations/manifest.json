  {
   "id": "cosine-response",
   "scene": "CosineResponseSequence",
   "section": 4,
   "title": "Matching cosines and sines, then one shifted cosine",
   "summary": "A cosine input needs a sine in the answer. Match coefficients for $M$ and $N$, then convert to gain $G$ and lag $\\alpha$.",
   "initial": {
    "title": "Cosine input",
    "tex": "y' = a\\,y + \\cos\\omega t",
    "explanation": "The derivative of a cosine is a sine, so a pure cosine guess cannot work.",
    "frame": "animations/cosine-response/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Guess both",
     "relation": "define",
     "relationLabel": "Definition / choice",
     "tex": "y_p = M\\cos\\omega t + N\\sin\\omega t",
     "explanation": "Two unknown numbers, $M$ and $N$.",
     "initialFrame": "animations/cosine-response/state-00.jpg",
     "finalFrame": "animations/cosine-response/state-01.jpg",
     "transition": {
      "src": "animations/cosine-response/step-01.mp4",
      "duration": 2.3667,
      "frames": 71,
      "masterFrames": [
       8,
       79
      ],
      "bytes": 43208,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Substitute and match",
     "relation": "substitute",
     "relationLabel": "Substitution",
     "tex": "\\cos:\\ -aM + \\omega N = 1, \\qquad \\sin:\\ -\\omega M - aN = 0",
     "explanation": "Cosine terms on both sides must agree, and so must sine terms: two equations.",
     "initialFrame": "animations/cosine-response/state-01.jpg",
     "finalFrame": "animations/cosine-response/state-02.jpg",
     "transition": {
      "src": "animations/cosine-response/step-02.mp4",
      "duration": 4.6,
      "frames": 138,
      "masterFrames": [
       78,
       216
      ],
      "bytes": 151855,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Solve for $M$ and $N$",
     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "M = \\frac{-a}{\\omega^2 + a^2}, \\qquad N = \\frac{\\omega}{\\omega^2 + a^2}",
     "explanation": "Two equations, two unknowns. Check: $-\\omega M - aN = 0$.",
     "initialFrame": "animations/cosine-response/state-02.jpg",
     "finalFrame": "animations/cosine-response/state-03.jpg",
     "transition": {
      "src": "animations/cosine-response/step-03.mp4",
      "duration": 2.6333,
      "frames": 79,
      "masterFrames": [
       215,
       294
      ],
      "bytes": 150781,
      "codec": "h264"
     }
    },
    {
     "index": 4,
     "title": "Polar form",
     "relation": "identity",
     "relationLabel": "Identity (=)",
     "tex": "y_p = G\\cos(\\omega t - \\alpha),\\quad G = \\frac{1}{\\sqrt{\\omega^2 + a^2}},\\quad \\tan\\alpha = \\frac{N}{M}",
     "explanation": "$(M, N) = (G\\cos\\alpha, G\\sin\\alpha)$: the gain is the length, the lag is the angle.",
     "initialFrame": "animations/cosine-response/state-03.jpg",
     "finalFrame": "animations/cosine-response/state-04.jpg",
     "transition": {
      "src": "animations/cosine-response/step-04.mp4",
      "duration": 4.0333,
      "frames": 121,
      "masterFrames": [
       293,
       414
      ],
      "bytes": 120931,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 13.633,
   "masterFrames": 414,
   "renderSeconds": 8.9
  },
  {
   "id": "any-input",
   "scene": "AnyInputSequence",
   "section": 5,
   "title": "Every deposit grows: the general formula",
   "summary": "Deposits $q(s)\\,ds$ made at times $s$ each grow by $e^{a(t-s)}$; adding them all is an integral.",
   "initial": {
    "title": "Deposits over time",
    "tex": "y' = a\\,y + q(t),\\quad y(0)",
    "explanation": "The starting balance and a continuous stream of deposits $q(t)$.",
    "frame": "animations/any-input/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "The starting deposit grows",
     "relation": "model",
     "relationLabel": "Modelling step",
     "tex": "y(0)\\,e^{at}",
     "explanation": "With no deposits the balance follows the null solution.",
     "initialFrame": "animations/any-input/state-00.jpg",
     "finalFrame": "animations/any-input/state-01.jpg",
     "transition": {
      "src": "animations/any-input/step-01.mp4",
      "duration": 2.0,
      "frames": 60,
      "masterFrames": [
       8,
       68
      ],
      "bytes": 28446,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "One deposit at time $s$",
     "relation": "model",
     "relationLabel": "Modelling step",
     "tex": "q(s)\\,ds \\;\\longrightarrow\\; e^{a(t-s)}\\,q(s)\\,ds",
     "explanation": "A deposit made at time $s$ grows only during the remaining time $t - s$.",
     "initialFrame": "animations/any-input/state-01.jpg",
     "finalFrame": "animations/any-input/state-02.jpg",
     "transition": {
      "src": "animations/any-input/step-02.mp4",
      "duration": 2.8667,
      "frames": 86,
      "masterFrames": [
       67,
       153
      ],
      "bytes": 47884,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Add them all",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "y(t) = y(0)\\,e^{at} + \\int_0^t e^{a(t-s)}\\,q(s)\\,ds",
     "explanation": "The equation is linear, so contributions add; adding continuously is integrating.",
     "initialFrame": "animations/any-input/state-02.jpg",
     "finalFrame": "animations/any-input/state-03.jpg",

  {
   "id": "free-oscillation",
   "scene": "FreeOscillationSequence",
   "section": 1,
   "title": "Free harmonic motion from two initial conditions",
   "summary": "Cosine and sine solve $y'' + \\omega_n^2y = 0$; $y(0)$ and $y'(0)$ fix the mix, which is one shifted cosine.",
   "initial": {
    "title": "No damping, no force",
    "tex": "y'' + \\omega_n^2\\,y = 0,\\qquad \\omega_n^2 = k/m",
    "explanation": "The example uses $\\omega_n = 2$, $y(0) = 1$, $y'(0) = 2$.",
    "frame": "animations/free-oscillation/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Two null solutions",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "(\\cos\\omega_n t)'' = -\\omega_n^2\\cos\\omega_n t,\\quad (\\sin\\omega_n t)'' = -\\omega_n^2\\sin\\omega_n t",
     "explanation": "Two derivatives bring out $-\\omega_n^2$, which the $\\omega_n^2y$ term cancels.",
     "initialFrame": "animations/free-oscillation/state-00.jpg",
     "finalFrame": "animations/free-oscillation/state-01.jpg",
     "transition": {
      "src": "animations/free-oscillation/step-01.mp4",
      "duration": 3.3,
      "frames": 99,
      "masterFrames": [
       8,
       107
      ],
      "bytes": 64087,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Match $y(0)$ and $y'(0)$",
     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "y = y(0)\\cos\\omega_n t + \\frac{y'(0)}{\\omega_n}\\sin\\omega_n t = \\cos 2t + \\sin 2t",
     "explanation": "At $t = 0$ only the cosine counts for $y$ and only the sine for $y'$.",
     "initialFrame": "animations/free-oscillation/state-01.jpg",
     "finalFrame": "animations/free-oscillation/state-02.jpg",
     "transition": {
      "src": "animations/free-oscillation/step-02.mp4",
      "duration": 2.8,
      "frames": 84,
      "masterFrames": [
       106,
       190
      ],
      "bytes": 148699,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "One cosine with a lag",
     "relation": "identity",
     "relationLabel": "Identity (=)",
     "tex": "\\cos 2t + \\sin 2t = \\sqrt2\\,\\cos\\left(2t - \\tfrac{\\pi}{4}\\right)",
     "explanation": "$R = \\sqrt{c_1^2 + c_2^2}$ and $\\tan\\alpha = c_2/c_1$. The amplitude never changes.",
     "initialFrame": "animations/free-oscillation/state-02.jpg",
     "finalFrame": "animations/free-oscillation/state-03.jpg",
     "transition": {
      "src": "animations/free-oscillation/step-03.mp4",
      "duration": 3.2,
      "frames": 96,
      "masterFrames": [
       189,
       285
      ],
      "bytes": 90160,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 9.3,
   "masterFrames": 285,
   "renderSeconds": 8.2
  },
  {
   "id": "forced-cosine",
   "scene": "ForcedCosineSequence",
   "section": 2,
   "title": "Forcing at frequency $\\omega$: the frequency response",
   "summary": "Substitute $Y\\cos\\omega t$, match cosines, and watch $Y$ blow up as $\\omega \\to \\omega_n$.",
   "initial": {
    "title": "Driven spring",
    "tex": "m y'' + k y = \\cos\\omega t",
    "explanation": "Outside frequency $\\omega$, natural frequency $\\omega_n = \\sqrt{k/m}$.",
    "frame": "animations/forced-cosine/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Try $Y\\cos\\omega t$",
     "relation": "substitute",
     "relationLabel": "Substitution",
     "tex": "-m\\omega^2 Y\\cos\\omega t + kY\\cos\\omega t = \\cos\\omega t",
     "explanation": "Two derivatives give $-\\omega^2$; without damping no sine appears.",
     "initialFrame": "animations/forced-cosine/state-00.jpg",
     "finalFrame": "animations/forced-cosine/state-01.jpg",
     "transition": {
      "src": "animations/forced-cosine/step-01.mp4",
      "duration": 2.6333,
      "frames": 79,
      "masterFrames": [
       8,
       87
      ],
      "bytes": 121084,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Match the cosines",
     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "Y = \\frac{1}{k - m\\omega^2} = \\frac{1}{m(\\omega_n^2 - \\omega^2)}",
     "explanation": "Use $k = m\\omega_n^2$.",
     "initialFrame": "animations/forced-cosine/state-01.jpg",
     "finalFrame": "animations/forced-cosine/state-02.jpg",
     "transition": {
      "src": "animations/forced-cosine/step-02.mp4",
      "duration": 2.8,
      "frames": 84,
      "masterFrames": [
       86,
       170
      ],
      "bytes": 89652,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Graph of $Y(\\omega)$",
     "relation": "diagram",
     "relationLabel": "Picture",
     "tex": "|Y| \\to \\infty \\text{ as } \\omega \\to \\omega_n",
     "explanation": "Pushing near the natural rhythm gives a huge response; at $\\omega = \\omega_n$ (resonance) a new formula is needed.",
     "initialFrame": "animations/forced-cosine/state-02.jpg",
     "finalFrame": "animations/forced-cosine/state-03.jpg",
     "transition": {
      "src": "animations/forced-cosine/step-03.mp4",
      "duration": 3.6333,
      "frames": 109,
      "masterFrames": [
       169,
       278
      ],
      "bytes": 88094,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 9.067,

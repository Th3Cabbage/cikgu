  {
   "id": "resonance-limit",
   "scene": "ResonanceLimitSequence",
   "section": 5,
   "title": "Resonance by l'Hôpital: $te^{s_1t}/P'(s_1)$",
   "summary": "Subtract a null solution so the quotient becomes $0/0$, then differentiate top and bottom in $s$.",
   "initial": {
    "title": "Exponential input",
    "tex": "P(D)\\,y = e^{st},\\qquad y_p = \\frac{e^{st}}{P(s)}",
    "explanation": "Fails when $P(s_1) = 0$.",
    "frame": "animations/resonance-limit/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Subtract a null solution",
     "relation": "substitute",
     "relationLabel": "Substitution",
     "tex": "y = \\frac{e^{st} - e^{s_1t}}{P(s)}",
     "explanation": "$e^{s_1t}/P(s)$ solves the null equation, so $y$ still solves $P(D)y = e^{st}$.",
     "initialFrame": "animations/resonance-limit/state-00.jpg",
     "finalFrame": "animations/resonance-limit/state-01.jpg",
     "transition": {
      "src": "animations/resonance-limit/step-01.mp4",
      "duration": 2.0667,
      "frames": 62,
      "masterFrames": [
       8,
       70
      ],
      "bytes": 66929,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Let $s \\to s_1$: $0/0$",
     "relation": "caution",
     "relationLabel": "Caveat",
     "tex": "\\frac{e^{s_1t} - e^{s_1t}}{P(s_1)} = \\frac{0}{0}",
     "explanation": "Top and bottom both vanish at the root.",
     "initialFrame": "animations/resonance-limit/state-01.jpg",
     "finalFrame": "animations/resonance-limit/state-02.jpg",
     "transition": {
      "src": "animations/resonance-limit/step-02.mp4",
      "duration": 2.3667,
      "frames": 71,
      "masterFrames": [
       69,
       140
      ],
      "bytes": 61548,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Differentiate in $s$",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "y_p = \\frac{\\partial_s(e^{st} - e^{s_1t})}{P'(s)}\\Big|_{s = s_1} = \\frac{t\\,e^{s_1t}}{P'(s_1)}",
     "explanation": "The derivative of $e^{st}$ with respect to $s$ is $te^{st}$: the factor $t$ of resonance.",
     "initialFrame": "animations/resonance-limit/state-02.jpg",
     "finalFrame": "animations/resonance-limit/state-03.jpg",
     "transition": {
      "src": "animations/resonance-limit/step-03.mp4",
      "duration": 2.8667,
      "frames": 86,
      "masterFrames": [
       139,
       225
      ],
      "bytes": 91576,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 7.3,
   "masterFrames": 225,

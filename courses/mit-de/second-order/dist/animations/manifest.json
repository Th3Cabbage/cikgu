  {
   "id": "gain-phase",
   "scene": "GainPhaseSequence",
   "section": 6,
   "title": "Rectangular to polar: $M\\cos + N\\sin = G\\cos(\\omega t - \\alpha)$",
   "summary": "For $y'' + y' + 2y = \\cos t$: $M = N = \\tfrac12$, so $G = 1/\\sqrt2$ and $\\alpha = \\pi/4$.",
   "initial": {
    "title": "Damped, driven",
    "tex": "y'' + y' + 2y = \\cos t",
    "explanation": "The $y'$ term turns cosines into sines.",
    "frame": "animations/gain-phase/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Match cos and sin",
     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "M = \\frac{C - A\\omega^2}{D} = \\tfrac12,\\quad N = \\frac{B\\omega}{D} = \\tfrac12,\\quad D = 2",
     "explanation": "$C - A\\omega^2 = 1$ and $B\\omega = 1$.",
     "initialFrame": "animations/gain-phase/state-00.jpg",
     "finalFrame": "animations/gain-phase/state-01.jpg",
     "transition": {
      "src": "animations/gain-phase/step-01.mp4",
      "duration": 2.2,
      "frames": 66,
      "masterFrames": [
       8,
       74
      ],
      "bytes": 61135,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "The point $(M, N)$",
     "relation": "diagram",
     "relationLabel": "Picture",
     "tex": "G = \\sqrt{M^2 + N^2} = \\tfrac{1}{\\sqrt2},\\qquad \\tan\\alpha = \\frac{N}{M} = 1",
     "explanation": "Length and angle of the vector from the origin to $(M, N)$.",
     "initialFrame": "animations/gain-phase/state-01.jpg",
     "finalFrame": "animations/gain-phase/state-02.jpg",
     "transition": {
      "src": "animations/gain-phase/step-02.mp4",
      "duration": 3.3667,
      "frames": 101,
      "masterFrames": [
       73,
       174
      ],
      "bytes": 64627,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "The response lags",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "y_p = \\tfrac{1}{\\sqrt2}\\cos\\left(t - \\tfrac{\\pi}{4}\\right)",
     "explanation": "Smaller by $G$ and later by $\\alpha/\\omega$ than the input $\\cos t$.",
     "initialFrame": "animations/gain-phase/state-02.jpg",

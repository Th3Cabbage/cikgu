  {
   "id": "damping-roots",
   "scene": "DampingRootsSequence",
   "section": 3,
   "title": "Raising the parabola $s^2 + 2s + C$",
   "summary": "Two real roots, then a double root, then complex roots: overdamped, critical, underdamped.",
   "initial": {
    "title": "Characteristic equation",
    "tex": "y = e^{st}:\\quad s^2 + 2s + C = 0",
    "explanation": "Here $A = 1$, $B = 2$; the spring constant $C$ will grow.",
    "frame": "animations/damping-roots/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "$C = 0$: roots $0$ and $-2$",
     "relation": "diagram",
     "relationLabel": "Picture",
     "tex": "s^2 + 2s = s(s + 2)",
     "explanation": "The parabola crosses zero twice: two real exponents.",
     "initialFrame": "animations/damping-roots/state-00.jpg",
     "finalFrame": "animations/damping-roots/state-01.jpg",
     "transition": {
      "src": "animations/damping-roots/step-01.mp4",
      "duration": 2.1333,
      "frames": 64,
      "masterFrames": [
       8,
       72
      ],
      "bytes": 36726,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "$C = 1$: a double root",
     "relation": "diagram",
     "relationLabel": "Picture",
     "tex": "s^2 + 2s + 1 = (s + 1)^2",
     "explanation": "It just touches zero at $-1$: critical damping, $e^{-t}$ and $te^{-t}$.",
     "initialFrame": "animations/damping-roots/state-01.jpg",
     "finalFrame": "animations/damping-roots/state-02.jpg",
     "transition": {
      "src": "animations/damping-roots/step-02.mp4",
      "duration": 2.3,
      "frames": 69,
      "masterFrames": [
       71,
       140
      ],
      "bytes": 57996,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "$C = 2$: complex roots",
     "relation": "diagram",
     "relationLabel": "Picture",
     "tex": "s^2 + 2s + 2 = 0 \\;\\Rightarrow\\; s = -1 \\pm i",
     "explanation": "No real roots: the motion oscillates while its amplitude decays like $e^{-t}$.",
     "initialFrame": "animations/damping-roots/state-02.jpg",
     "finalFrame": "animations/damping-roots/state-03.jpg",
     "transition": {
      "src": "animations/damping-roots/step-03.mp4",
      "duration": 2.3667,
      "frames": 71,
      "masterFrames": [
       139,
       210
      ],
      "bytes": 58435,
      "codec": "h264"
     }
    },
    {
     "index": 4,
     "title": "The four cases",
     "relation": "classify",
     "relationLabel": "Classification",
     "tex": "B^2 > 4AC,\\quad B^2 = 4AC,\\quad B^2 < 4AC,\\quad B = 0",
     "explanation": "Overdamped, critical, underdamped, undamped.",
     "initialFrame": "animations/damping-roots/state-03.jpg",
     "finalFrame": "animations/damping-roots/state-04.jpg",
     "transition": {
      "src": "animations/damping-roots/step-04.mp4",
      "duration": 2.0667,
      "frames": 62,
      "masterFrames": [
       209,
       271
      ],
      "bytes": 64584,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 8.867,

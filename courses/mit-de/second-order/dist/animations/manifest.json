  {
   "id": "impulse-step",
   "scene": "ImpulseStepSequence",
   "section": 4,
   "title": "From the impulse response to the step response",
   "summary": "Build $g$ from two exponentials with $g(0) = 0$, $g'(0) = 1$, then integrate it to get $r$.",
   "initial": {
    "title": "An example",
    "tex": "y'' + 3y' + 2y,\\qquad s_1 = -1,\\ s_2 = -2",
    "explanation": "Overdamped: two negative real roots.",
    "frame": "animations/impulse-step/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Impulse response",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "g(t) = \\frac{e^{s_1t} - e^{s_2t}}{s_1 - s_2} = e^{-t} - e^{-2t}",
     "explanation": "The difference starts at $0$; dividing by $s_1 - s_2$ makes the starting slope $1$.",
     "initialFrame": "animations/impulse-step/state-00.jpg",
     "finalFrame": "animations/impulse-step/state-01.jpg",
     "transition": {
      "src": "animations/impulse-step/step-01.mp4",
      "duration": 2.7333,
      "frames": 82,
      "masterFrames": [
       8,
       90
      ],
      "bytes": 46590,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Step = integral of impulse",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "r(t) = \\int_0^t g(s)\\,ds",
     "explanation": "The step function is the integral of the delta function.",
     "initialFrame": "animations/impulse-step/state-01.jpg",
     "finalFrame": "animations/impulse-step/state-02.jpg",
     "transition": {
      "src": "animations/impulse-step/step-02.mp4",
      "duration": 1.9667,
      "frames": 59,
      "masterFrames": [
       89,
       148
      ],
      "bytes": 52889,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "The step response",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "r(t) = \\tfrac12 - e^{-t} + \\tfrac12e^{-2t} \\;\\to\\; \\tfrac{1}{C} = \\tfrac12",
     "explanation": "Area under $g$ so far. It settles at $1/C$.",
     "initialFrame": "animations/impulse-step/state-02.jpg",
     "finalFrame": "animations/impulse-step/state-03.jpg",
     "transition": {
      "src": "animations/impulse-step/step-03.mp4",
      "duration": 2.8,
      "frames": 84,
      "masterFrames": [
       147,
       231
      ],
      "bytes": 56582,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 7.5,
   "masterFrames": 231,
   "renderSeconds": 7.3

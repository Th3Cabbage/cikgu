  {
   "id": "solve-system",
   "scene": "SolveSystemSequence",
   "section": 3,
   "title": "Trajectories of $y' = Ay$ for $A = \\begin{bmatrix}-1&2\\\\1&-2\\end{bmatrix}$",
   "summary": "A line of steady states ($\\lambda = 0$) and decay along $(1, -1)$ ($\\lambda = -3$).",
   "initial": {
    "title": "Eigenvalues",
    "tex": "T = -3,\\ D = 0:\\quad \\lambda = 0,\\ -3",
    "explanation": "Columns add to $0$, so $0$ is an eigenvalue.",
    "frame": "animations/solve-system/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Eigenvector lines",
     "relation": "diagram",
     "relationLabel": "Picture",
     "tex": "\\lambda = 0:\\ (2, 1),\\qquad \\lambda = -3:\\ (1, -1)",
     "explanation": "Points on the first line do not move.",
     "initialFrame": "animations/solve-system/state-00.jpg",
     "finalFrame": "animations/solve-system/state-01.jpg",
     "transition": {
      "src": "animations/solve-system/step-01.mp4",
      "duration": 1.9,
      "frames": 57,
      "masterFrames": [
       8,
       65
      ],
      "bytes": 31888,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Solutions",
     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "y(t) = c_1(2, 1) + c_2e^{-3t}(1, -1)",
     "explanation": "The second part decays; every trajectory is a straight segment parallel to $(1, -1)$.",
     "initialFrame": "animations/solve-system/state-01.jpg",
     "finalFrame": "animations/solve-system/state-02.jpg",
     "transition": {
      "src": "animations/solve-system/step-02.mp4",
      "duration": 2.8333,
      "frames": 85,
      "masterFrames": [
       64,
       149
      ],
      "bytes": 49632,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "The steady state",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "y(t) \\to c_1(2, 1)",
     "explanation": "Where it lands depends on $c_1$, fixed by $y(0)$.",
     "initialFrame": "animations/solve-system/state-02.jpg",
     "finalFrame": "animations/solve-system/state-03.jpg",
     "transition": {
      "src": "animations/solve-system/step-03.mp4",
      "duration": 1.3333,
      "frames": 40,

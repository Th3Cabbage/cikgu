  {
   "id": "expm-series",
   "scene": "ExpmSeriesSequence",
   "section": 4,
   "title": "The series for $e^{At}$ when $A^2 = 0$",
   "summary": "For $A = \\begin{bmatrix}0&1\\\\0&0\\end{bmatrix}$ the series stops after two terms: $e^{At} = I + At$.",
   "initial": {
    "title": "The series",
    "tex": "e^{At} = I + At + \\tfrac12(At)^2 + \\tfrac16(At)^3 + \\cdots",
    "explanation": "Copied from the scalar exponential.",
    "frame": "animations/expm-series/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Square the matrix",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "A^2 = \\begin{bmatrix}0&1\\\\0&0\\end{bmatrix}\\begin{bmatrix}0&1\\\\0&0\\end{bmatrix} = 0",
     "explanation": "All higher powers vanish too.",
     "initialFrame": "animations/expm-series/state-00.jpg",
     "finalFrame": "animations/expm-series/state-01.jpg",
     "transition": {
      "src": "animations/expm-series/step-01.mp4",
      "duration": 1.8333,
      "frames": 55,
      "masterFrames": [
       8,
       63
      ],
      "bytes": 37206,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "The series stops",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "e^{At} = I + At = \\begin{bmatrix}1 & t\\\\ 0 & 1\\end{bmatrix}",
     "explanation": "No exponential growth, only a factor $t$.",
     "initialFrame": "animations/expm-series/state-01.jpg",
     "finalFrame": "animations/expm-series/state-02.jpg",
     "transition": {
      "src": "animations/expm-series/step-02.mp4",
      "duration": 1.9,
      "frames": 57,
      "masterFrames": [
       62,
       119
      ],
      "bytes": 42660,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Check: $y' = Ay$",
     "relation": "compare",
     "relationLabel": "Check",
     "tex": "y_2' = 0,\\quad y_1' = y_2 \\;\\Rightarrow\\; y = (y_1(0) + t\\,y_2(0),\\ y_2(0))",
     "explanation": "The defective matrix has one eigenvector $(1, 0)$; the factor $t$ replaces the missing one.",
     "initialFrame": "animations/expm-series/state-02.jpg",
     "finalFrame": "animations/expm-series/state-03.jpg",

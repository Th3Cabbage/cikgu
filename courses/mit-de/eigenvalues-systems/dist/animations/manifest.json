   "id": "eig-check",
   "scene": "EigCheckSequence",
   "section": 1,
   "title": "Checking $Ax = \\lambda x$ for $A = \\begin{bmatrix}5&1\\\\3&3\\end{bmatrix}$",
   "summary": "Multiply out $A(1,1)$ and $A(1,-3)$ and see each output is a multiple of the input.",
   "initial": {
    "title": "The system",
    "tex": "y_1' = 5y_1 + y_2,\\quad y_2' = 3y_1 + 3y_2",
    "explanation": "Try $y = e^{\\lambda t}x$.",
    "frame": "animations/eig-check/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "First eigenvector",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "\\begin{bmatrix}5&1\\\\3&3\\end{bmatrix}\\begin{bmatrix}1\\\\1\\end{bmatrix} = \\begin{bmatrix}6\\\\6\\end{bmatrix} = 6\\begin{bmatrix}1\\\\1\\end{bmatrix}",
     "explanation": "Row times column: $5 + 1$ and $3 + 3$.",
     "initialFrame": "animations/eig-check/state-00.jpg",
     "finalFrame": "animations/eig-check/state-01.jpg",
     "transition": {
      "src": "animations/eig-check/step-01.mp4",
      "duration": 2.8333,
      "frames": 85,
      "masterFrames": [
       8,
       93
      ],
      "bytes": 42611,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Second eigenvector",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "\\begin{bmatrix}5&1\\\\3&3\\end{bmatrix}\\begin{bmatrix}1\\\\-3\\end{bmatrix} = \\begin{bmatrix}2\\\\-6\\end{bmatrix} = 2\\begin{bmatrix}1\\\\-3\\end{bmatrix}",
     "explanation": "$5 - 3 = 2$ and $3 - 9 = -6$.",
     "initialFrame": "animations/eig-check/state-01.jpg",
     "finalFrame": "animations/eig-check/state-02.jpg",
     "transition": {
      "src": "animations/eig-check/step-02.mp4",
      "duration": 1.9,
      "frames": 57,
      "masterFrames": [
       92,
       149
      ],
      "bytes": 44605,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "The solution",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "y(t) = c_1e^{6t}(1, 1) + c_2e^{2t}(1, -3)",
     "explanation": "Each eigenvector grows at its own rate.",
     "initialFrame": "animations/eig-check/state-02.jpg",
     "finalFrame": "animations/eig-check/state-03.jpg",
     "transition": {
      "src": "animations/eig-check/step-03.mp4",
      "duration": 1.9,
      "frames": 57,
      "masterFrames": [
       148,
       205
      ],
      "bytes": 67037,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 6.633,
   "masterFrames": 205,
   "renderSeconds": 9.9
  },
  {
   "id": "diag-markov",
   "scene": "DiagMarkovSequence",
   "section": 2,
   "title": "$AV = V\\Lambda$ and the steady state of a Markov matrix",
   "summary": "Eigenvectors as columns diagonalize $A$; powers keep the $\\lambda = 1$ part and shrink the $\\lambda = \\tfrac12$ part.",
   "initial": {
    "title": "A Markov matrix",
    "tex": "A = \\begin{bmatrix}0.8 & 0.3\\\\ 0.2 & 0.7\\end{bmatrix}",
    "explanation": "Columns add to $1$.",
    "frame": "animations/diag-markov/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Eigenvectors as columns",
     "relation": "identity",
     "relationLabel": "Identity (=)",
     "tex": "A\\begin{bmatrix}0.6 & 1\\\\ 0.4 & -1\\end{bmatrix} = \\begin{bmatrix}0.6 & 1\\\\ 0.4 & -1\\end{bmatrix}\\begin{bmatrix}1 & 0\\\\ 0 & \\tfrac12\\end{bmatrix}",
     "explanation": "$AV = V\\Lambda$: each column is multiplied by its eigenvalue.",
     "initialFrame": "animations/diag-markov/state-00.jpg",
     "finalFrame": "animations/diag-markov/state-01.jpg",
     "transition": {
      "src": "animations/diag-markov/step-01.mp4",
      "duration": 2.1333,
      "frames": 64,
      "masterFrames": [
       8,
       72
      ],
      "bytes": 63601,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Expand the start",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "u_0 = (1, 0) = (0.6, 0.4) + 0.4\\,(1, -1)",
     "explanation": "$c = V^{-1}u_0$.",
     "initialFrame": "animations/diag-markov/state-01.jpg",
     "finalFrame": "animations/diag-markov/state-02.jpg",
     "transition": {
      "src": "animations/diag-markov/step-02.mp4",
      "duration": 1.5,
      "frames": 45,
      "masterFrames": [
       71,
       116
      ],
      "bytes": 66496,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Powers",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "u_k = (0.6, 0.4) + 0.4\\left(\\tfrac12\\right)^k(1, -1) \\to (0.6, 0.4)",
     "explanation": "The steady state is the $\\lambda = 1$ eigenvector.",
     "initialFrame": "animations/diag-markov/state-02.jpg",
     "finalFrame": "animations/diag-markov/state-03.jpg",
     "transition": {
      "src": "animations/diag-markov/step-03.mp4",
      "duration": 3.4,
      "frames": 102,
      "masterFrames": [
       115,
       217
      ],
      "bytes": 76411,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 7.033,
   "masterFrames": 217,

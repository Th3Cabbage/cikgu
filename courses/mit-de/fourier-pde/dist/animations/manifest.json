  {
   "id": "poisson-disc",
   "scene": "PoissonDiscSequence",
   "section": 5,
   "title": "From delta boundary data to the Poisson kernel",
   "summary": "Each boundary cosine is damped by $r^n$; the geometric series sums in closed form.",
   "initial": {
    "title": "Boundary data",
    "tex": "u(1, \\theta) = \\delta(\\theta) = \\tfrac{1}{2\\pi} + \\tfrac1\\pi\\sum\\cos n\\theta",
    "explanation": "Coefficients from Section 3.",
    "frame": "animations/poisson-disc/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Damp by $r^n$",
     "relation": "substitute",
     "relationLabel": "Substitution",
     "tex": "u(r, \\theta) = \\tfrac{1}{2\\pi} + \\tfrac1\\pi\\sum_{n\\ge1} r^n\\cos n\\theta",
     "explanation": "Each term is harmonic and matches the boundary at $r = 1$.",
     "initialFrame": "animations/poisson-disc/state-00.jpg",
     "finalFrame": "animations/poisson-disc/state-01.jpg",
     "transition": {
      "src": "animations/poisson-disc/step-01.mp4",
      "duration": 2.6333,
      "frames": 79,
      "masterFrames": [
       8,
       87
      ],
      "bytes": 53271,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "A geometric series",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "1 + 2\\sum_{n\\ge1}(re^{i\\theta})^n = \\frac{1 + re^{i\\theta}}{1 - re^{i\\theta}}",
     "explanation": "Take the real part.",
     "initialFrame": "animations/poisson-disc/state-01.jpg",
     "finalFrame": "animations/poisson-disc/state-02.jpg",
     "transition": {
      "src": "animations/poisson-disc/step-02.mp4",
      "duration": 1.5,
      "frames": 45,
      "masterFrames": [
       86,
       131
      ],
      "bytes": 53370,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "The kernel",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "u(r, \\theta) = \\frac{1}{2\\pi}\\,\\frac{1 - r^2}{1 + r^2 - 2r\\cos\\theta}",
     "explanation": "Huge near $\\theta = 0$ on the edge, $\\tfrac{1}{2\\pi}$ (the average) at the centre.",
     "initialFrame": "animations/poisson-disc/state-02.jpg",
     "finalFrame": "animations/poisson-disc/state-03.jpg",
     "transition": {
      "src": "animations/poisson-disc/step-03.mp4",

  {
   "id": "point-load",
   "scene": "PointLoadSequence",
   "section": 1,
   "title": "A point load: two straight lines and a slope drop",
   "summary": "Linear on each side, zero at the ends, continuous at $a$, slope drops by $1$.",
   "initial": {
    "title": "The problem",
    "tex": "-y'' = \\delta(x - a),\\quad y(0) = y(1) = 0",
    "explanation": "A unit load at $x = a$ on a bar fixed at both ends.",
    "frame": "animations/point-load/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Lines on each side",
     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "y = Cx\\ (x < a),\\qquad y = E(1 - x)\\ (x > a)",
     "explanation": "No load away from $a$, so $y'' = 0$; the ends are fixed.",
     "initialFrame": "animations/point-load/state-00.jpg",
     "finalFrame": "animations/point-load/state-01.jpg",
     "transition": {
      "src": "animations/point-load/step-01.mp4",
      "duration": 1.7333,
      "frames": 52,
      "masterFrames": [
       8,
       60
      ],
      "bytes": 41256,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Match at $x = a$",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "Ca = E(1 - a),\\qquad -E - C = -1",
     "explanation": "Continuity, and the slope drops by exactly $1$.",
     "initialFrame": "animations/point-load/state-01.jpg",
     "finalFrame": "animations/point-load/state-02.jpg",
     "transition": {
      "src": "animations/point-load/step-02.mp4",
      "duration": 1.9667,
      "frames": 59,
      "masterFrames": [
       59,
       118
      ],
      "bytes": 48815,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "The answer",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "y = (1 - a)x\\ \\ (x \\le a),\\qquad y = a(1 - x)\\ \\ (x \\ge a)",
     "explanation": "A tent with its corner under the load.",
     "initialFrame": "animations/point-load/state-02.jpg",
     "finalFrame": "animations/point-load/state-03.jpg",
     "transition": {
      "src": "animations/point-load/step-03.mp4",
      "duration": 1.4,
      "frames": 42,
      "masterFrames": [
       117,
       159
      ],
      "bytes": 54982,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 5.1,

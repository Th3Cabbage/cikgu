  {
   "id": "orthogonality",
   "scene": "OrthogonalitySequence",
   "section": 3,
   "title": "Isolating $a_k$: multiply by $\\cos kx$ and integrate",
   "summary": "Every other term integrates to zero; what remains is $\\pi a_k$.",
   "initial": {
    "title": "The series",
    "tex": "f(x) = a_0 + a_1\\cos x + a_2\\cos 2x + \\cdots + b_1\\sin x + \\cdots",
    "explanation": "Unknown coefficients.",
    "frame": "animations/orthogonality/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Multiply by $\\cos kx$",
     "relation": "substitute",
     "relationLabel": "Substitution",
     "tex": "\\int_{-\\pi}^{\\pi}f\\cos kx\\,dx = \\sum_n a_n\\int\\cos nx\\cos kx\\,dx + \\sum_n b_n\\int\\sin nx\\cos kx\\,dx",
     "explanation": "Integrate each term over one period.",
     "initialFrame": "animations/orthogonality/state-00.jpg",
     "finalFrame": "animations/orthogonality/state-01.jpg",
     "transition": {
      "src": "animations/orthogonality/step-01.mp4",
      "duration": 1.6667,
      "frames": 50,
      "masterFrames": [
       8,
       58
      ],
      "bytes": 195483,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Orthogonality",
     "relation": "identity",
     "relationLabel": "Identity (=)",
     "tex": "\\int_{-\\pi}^{\\pi}\\cos nx\\cos kx\\,dx = 0\\ (n \\neq k),\\qquad \\int_{-\\pi}^{\\pi}\\cos^2 kx\\,dx = \\pi",
     "explanation": "Products of different frequencies average to zero.",
     "initialFrame": "animations/orthogonality/state-01.jpg",
     "finalFrame": "animations/orthogonality/state-02.jpg",
     "transition": {
      "src": "animations/orthogonality/step-02.mp4",
      "duration": 2.4,
      "frames": 72,
      "masterFrames": [
       57,
       129
      ],
      "bytes": 80888,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "The formula",
     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "a_k = \\frac{1}{\\pi}\\int_{-\\pi}^{\\pi}f(x)\\cos kx\\,dx",
     "explanation": "Likewise $b_k$ with $\\sin kx$, and $a_0$ is the average.",
     "initialFrame": "animations/orthogonality/state-02.jpg",
     "finalFrame": "animations/orthogonality/state-03.jpg",
     "transition": {
      "src": "animations/orthogonality/step-03.mp4",
      "duration": 1.8,
      "frames": 54,
      "masterFrames": [
       128,
       182
      ],
      "bytes": 82480,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 5.867,
   "masterFrames": 182,
   "renderSeconds": 7.6

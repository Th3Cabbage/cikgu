  {
   "id": "harmonic-pattern",
   "scene": "HarmonicPatternSequence",
   "section": 2,
   "title": "Solutions of Laplace's equation from $(x + iy)^n$",
   "summary": "Expand powers of $x + iy$; real and imaginary parts are harmonic; in polar form they are $r^n\\cos n\\theta$, $r^n\\sin n\\theta$.",
   "initial": {
    "title": "Laplace's equation",
    "tex": "u_{xx} + u_{yy} = 0",
    "explanation": "Which polynomials solve it?",
    "frame": "animations/harmonic-pattern/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Square",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "(x + iy)^2 = (x^2 - y^2) + i\\,(2xy)",
     "explanation": "Both parts solve the equation: $2 - 2 = 0$ and $0 + 0 = 0$.",
     "initialFrame": "animations/harmonic-pattern/state-00.jpg",
     "finalFrame": "animations/harmonic-pattern/state-01.jpg",
     "transition": {
      "src": "animations/harmonic-pattern/step-01.mp4",
      "duration": 1.9,
      "frames": 57,
      "masterFrames": [
       8,
       65
      ],
      "bytes": 38976,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Cube",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "(x + iy)^3 = (x^3 - 3xy^2) + i\\,(3x^2y - y^3)",
     "explanation": "$u_{xx} = 6x$, $u_{yy} = -6x$ for the real part.",
     "initialFrame": "animations/harmonic-pattern/state-01.jpg",
     "finalFrame": "animations/harmonic-pattern/state-02.jpg",
     "transition": {
      "src": "animations/harmonic-pattern/step-02.mp4",
      "duration": 2.0,
      "frames": 60,
      "masterFrames": [
       64,
       124
      ],
      "bytes": 55546,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Polar form",
     "relation": "identity",
     "relationLabel": "Identity (=)",
     "tex": "(re^{i\\theta})^n = r^n\\cos n\\theta + i\\,r^n\\sin n\\theta",
     "explanation": "Two harmonic functions for every $n$.",
     "initialFrame": "animations/harmonic-pattern/state-02.jpg",
     "finalFrame": "animations/harmonic-pattern/state-03.jpg",
     "transition": {
      "src": "animations/harmonic-pattern/step-03.mp4",
      "duration": 1.9,
      "frames": 57,
      "masterFrames": [
       123,
       180
      ],
      "bytes": 64944,
      "codec": "h264"
     }
    }
   ],
   "totalDuration": 5.8,

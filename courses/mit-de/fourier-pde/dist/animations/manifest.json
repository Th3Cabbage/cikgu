  {
   "id": "heat-modes",
   "scene": "HeatModesSequence",
   "section": 6,
   "title": "A hot bar cools: modes decay at rates $k^2\\pi^2$",
   "summary": "$u(0, x) = 1$ has sine coefficients $\\tfrac{4}{k\\pi}$ (odd $k$); high modes vanish first.",
   "initial": {
    "title": "A uniform start",
    "tex": "u(0, x) = 1,\\quad u(t, 0) = u(t, 1) = 0",
    "explanation": "A hot bar with cold ends.",
    "frame": "animations/heat-modes/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Sine series",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "1 = \\frac4\\pi\\left(\\sin\\pi x + \\tfrac13\\sin 3\\pi x + \\tfrac15\\sin 5\\pi x + \\cdots\\right)",
     "explanation": "The square wave again, on $[0, 1]$.",
     "initialFrame": "animations/heat-modes/state-00.jpg",
     "finalFrame": "animations/heat-modes/state-01.jpg",
     "transition": {
      "src": "animations/heat-modes/step-01.mp4",
      "duration": 1.9,
      "frames": 57,
      "masterFrames": [
       8,
       65
      ],
      "bytes": 50769,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Each mode decays",
     "relation": "solve",
     "relationLabel": "Solve",
     "tex": "u = \\frac4\\pi\\sum_{k\\ \\mathrm{odd}}\\frac{e^{-k^2\\pi^2t}}{k}\\sin k\\pi x",
     "explanation": "Separation: $\\sin k\\pi x$ with $\\lambda = -k^2\\pi^2$.",
     "initialFrame": "animations/heat-modes/state-01.jpg",
     "finalFrame": "animations/heat-modes/state-02.jpg",
     "transition": {
      "src": "animations/heat-modes/step-02.mp4",
      "duration": 2.7667,
      "frames": 83,
      "masterFrames": [
       64,
       147
      ],
      "bytes": 80395,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "One arch remains",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "u \\approx \\tfrac4\\pi e^{-\\pi^2t}\\sin\\pi x",
     "explanation": "The corners at the ends smooth out almost at once.",
     "initialFrame": "animations/heat-modes/state-02.jpg",
     "finalFrame": "animations/heat-modes/state-03.jpg",
     "transition": {

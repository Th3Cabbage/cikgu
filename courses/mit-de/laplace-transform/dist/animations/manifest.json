  {
   "id": "convolution",
   "scene": "ConvolutionSequence",
   "section": 3,
   "title": "Convolution reproduces the partial-fraction answer",
   "summary": "For $G = 1/(s - a)$ and $F = 1/(s - c)$, $\\int_0^t e^{a(t-T)}e^{cT}dT$ equals the inverse of $GF$.",
   "initial": {
    "title": "Product of transforms",
    "tex": "Y = G\\,F = \\frac{1}{s - a}\\cdot\\frac{1}{s - c}",
    "explanation": "From rest: output transform = transfer function times input transform.",
    "frame": "animations/convolution/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Convolution integral",
     "relation": "define",
     "relationLabel": "Definition / choice",
     "tex": "y(t) = \\int_0^t g(t - T)\\,f(T)\\,dT = \\int_0^t e^{a(t - T)}\\,e^{cT}\\,dT",
     "explanation": "Each input at time $T$ grows by $e^{a(t - T)}$.",
     "initialFrame": "animations/convolution/state-00.jpg",
     "finalFrame": "animations/convolution/state-01.jpg",
     "transition": {
      "src": "animations/convolution/step-01.mp4",
      "duration": 2.1667,
      "frames": 65,
      "masterFrames": [
       8,
       73
      ],
      "bytes": 57083,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Pull out $e^{at}$",
     "relation": "compute",
     "relationLabel": "Computation",
     "tex": "= e^{at}\\int_0^t e^{(c - a)T}\\,dT = e^{at}\\,\\frac{e^{(c - a)t} - 1}{c - a}",
     "explanation": "One exponential integral.",
     "initialFrame": "animations/convolution/state-01.jpg",
     "finalFrame": "animations/convolution/state-02.jpg",
     "transition": {
      "src": "animations/convolution/step-02.mp4",
      "duration": 2.6333,
      "frames": 79,
      "masterFrames": [
       72,
       151
      ],
      "bytes": 146942,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Same answer",
     "relation": "compare",
     "relationLabel": "Check",
     "tex": "y = \\frac{e^{ct} - e^{at}}{c - a}",
     "explanation": "Identical to the partial-fraction result with $y(0) = 0$.",

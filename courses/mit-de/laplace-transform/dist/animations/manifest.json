  },
  {
   "id": "cos-transform",
   "scene": "CosTransformSequence",
   "section": 2,
   "title": "$\\mathcal{L}[\\cos\\omega t]$ from $e^{i\\omega t}$",
   "summary": "Multiply $1/(s - i\\omega)$ by its conjugate; the real part is the cosine transform, the imaginary part the sine.",
   "initial": {
    "title": "Complex exponential",
    "tex": "\\mathcal{L}[e^{i\\omega t}] = \\frac{1}{s - i\\omega}",
    "explanation": "The rule for $e^{at}$ with $a = i\\omega$.",
    "frame": "animations/cos-transform/state-00.jpg"
   },
   "steps": [
    {
     "index": 1,
     "title": "Multiply by the conjugate",
     "relation": "identity",
     "relationLabel": "Identity (=)",
     "tex": "\\frac{1}{s - i\\omega}\\cdot\\frac{s + i\\omega}{s + i\\omega} = \\frac{s + i\\omega}{s^2 + \\omega^2}",
     "explanation": "$(s - i\\omega)(s + i\\omega) = s^2 + \\omega^2$ is real.",
     "initialFrame": "animations/cos-transform/state-00.jpg",
     "finalFrame": "animations/cos-transform/state-01.jpg",
     "transition": {
      "src": "animations/cos-transform/step-01.mp4",
      "duration": 2.7333,
      "frames": 82,
      "masterFrames": [
       8,
       90
      ],
      "bytes": 48637,
      "codec": "h264"
     }
    },
    {
     "index": 2,
     "title": "Real and imaginary parts",
     "relation": "implies",
     "relationLabel": "Consequence (⇒)",
     "tex": "\\mathcal{L}[\\cos\\omega t] = \\frac{s}{s^2 + \\omega^2},\\qquad \\mathcal{L}[\\sin\\omega t] = \\frac{\\omega}{s^2 + \\omega^2}",
     "explanation": "$e^{i\\omega t} = \\cos\\omega t + i\\sin\\omega t$, and the transform is linear.",
     "initialFrame": "animations/cos-transform/state-01.jpg",
     "finalFrame": "animations/cos-transform/state-02.jpg",
     "transition": {
      "src": "animations/cos-transform/step-02.mp4",
      "duration": 2.5667,
      "frames": 77,
      "masterFrames": [
       89,
       166
      ],
      "bytes": 102827,
      "codec": "h264"
     }
    },
    {
     "index": 3,
     "title": "Poles at $\\pm i\\omega$",
     "relation": "diagram",
     "relationLabel": "Picture",
     "tex": "s^2 + \\omega^2 = 0 \\;\\Rightarrow\\; s = \\pm i\\omega",
     "explanation": "Oscillation in time means poles on the imaginary axis.",
     "initialFrame": "animations/cos-transform/state-02.jpg",
     "finalFrame": "animations/cos-transform/state-03.jpg",
     "transition": {
      "src": "animations/cos-transform/step-03.mp4",
      "duration": 1.7333,
      "frames": 52,
      "masterFrames": [

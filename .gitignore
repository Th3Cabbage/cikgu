# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]

# Node (install with `npm ci` in qa/tooling)
node_modules/

# Hosting/deployment configuration and identity
.openai/
.env
.env.*
*.pem
*.key

# Local ManimGL output: master renders, stamps, render probes, scratch renders
animation/masters/
animation/review-render/
animation/_probe/
*.stamp
/media/
/videos/
/backup/

# QA output (regenerated by the checks)
qa/results/
qa/screenshots/
qa/scratch/
qa/tooling/katex-download/

# Logs, archives, reports, process files
*.log
*.pid
*.tgz
*.zip
*.7z
*.tar
*.tar.gz
*_REPORT.md
*.jsonl

# Editor/OS files
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# The published site is versioned as-is: keep every browser/dist asset
# (step clips, stills, posters, KaTeX fonts and LICENSE) even if a rule above matches.
!browser/dist/
!browser/dist/**

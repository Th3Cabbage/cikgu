.venv/
.venv-download/
/sources/
/databook.pdf
venv/
__pycache__/
*.py[cod]

# Node (install with `npm ci` in qa/tooling)
node_modules/

# Hosting/deployment configuration and identity
.openai/
.env
.env.*
*.pem
*.key

# Local ManimGL output: master renders, stamps, render probes, scratch renders
courses/ode/animation/masters/
courses/ode/animation/review-render/
courses/ode/animation/_probe/
*.stamp
/media/
/videos/
/backup/

# Generated website (node site/build.mjs); the package dist/ folders it copies are tracked
/site/dist/

# QA output (regenerated by the checks)
qa/results/
qa/screenshots/
qa/scratch/
qa/tooling/katex-download/

# Logs, archives, reports, process files
*.log
*.pid
*.tgz
*.zip
*.7z
*.tar
*.tar.gz
*_REPORT.md
*.jsonl

# Editor/OS files
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# The published site is versioned as-is: keep every courses/ode/browser/dist asset
# (step clips, stills, posters, KaTeX fonts and LICENSE) even if a rule above matches.
!courses/ode/browser/dist/
!courses/ode/browser/dist/**
